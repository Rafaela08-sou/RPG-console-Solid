---
title: Diagrama de Classes UML - RPG em Console
config:
  theme: base
  layout: elk
  fontFamily: Arial, Helvetica, sans-serif
  themeVariables:
    fontFamily: Arial, Helvetica, sans-serif
    fontSize: 14px
    lineColor: '#1f2937'
    primaryTextColor: '#1f2937'
---
classDiagram
    direction TB

    %% ===== pacote rpg.combate (contratos) =====
    class Atacante {
        <<interface>>
        +getNome() String
        +getAtaque() int
    }
    class Alvo {
        <<interface>>
        +getNome() String
        +getVida() int
        +getVidaMaxima() int
        +estaVivo() boolean
        +receberDano(int danoBruto) int
    }
    class Oponente {
        <<interface>>
        +agir(Alvo alvo) String
    }

    %% ===== pacote rpg.habilidades =====
    class Habilidade {
        <<interface>>
        +getNome() String
        +getCusto() int
        +usar(Atacante usuario, Alvo alvo) String
    }
    class HabilidadeDeDano {
        -nome : String
        -custo : int
        -multiplicador : double
        -golpes : int
        +HabilidadeDeDano(String nome, int custo, double multiplicador, int golpes)
        +getNome() String
        +getCusto() int
        +usar(Atacante usuario, Alvo alvo) String
    }

    %% ===== pacote rpg.personagens =====
    class Combatente {
        <<abstract>>
        -nome : String
        -vidaMaxima : int
        -vida : int
        -ataque : int
        -defesa : int
        #Combatente(String nome, int vida, int ataque, int defesa)
        +getNome() String
        +getVida() int
        +getVidaMaxima() int
        +getAtaque() int
        +getDefesa() int
        +estaVivo() boolean
        +receberDano(int danoBruto) int
        +curar(int quantidade) void
        +aumentarAtaque(int valor) void
        +aumentarDefesa(int valor) void
    }
    class Personagem {
        <<abstract>>
        -ENERGIA_MAXIMA : int$
        -ATAQUE_BASICO : Habilidade$
        -energia : int
        -habilidades : List~Habilidade~
        -inventario : Inventario
        #Personagem(String nome, int vida, int ataque, int defesa, Habilidade habilidadeEspecial)
        +getClasse() String*
        +gastarEnergia(int custo) boolean
        +recuperarEnergia(int valor) void
        +getEnergia() int
        +getEnergiaMaxima() int
        +getHabilidades() List~Habilidade~
        +getInventario() Inventario
    }
    class Guerreiro {
        +Guerreiro(String nome)
        +getClasse() String
    }
    class Mago {
        +Mago(String nome)
        +getClasse() String
    }
    class Arqueiro {
        +Arqueiro(String nome)
        +getClasse() String
    }
    class Inimigo {
        -habilidade : Habilidade
        +Inimigo(String nome, int vida, int ataque, int defesa, Habilidade habilidade)
        +agir(Alvo alvo) String
    }
    class FabricaDePersonagens {
        -CLASSES : Map#lt;String, Function#lt;String, Personagem#gt;#gt;$
        -FabricaDePersonagens()
        +classesDisponiveis() List~String~$
        +criar(String classe, String nome) Personagem$
    }


    direction TB

    %% ===== pacote rpg =====
    class Main {
        +main(String[] args) void$
    }
    class Jogo {
        -PERCENTUAL_CURA_DESCANSO : double$
        -ENERGIA_DESCANSO : int$
        -CURA_INICIAL : int$
        -ENERGIA_INICIAL : int$
        -ui : InterfaceJogo
        -fases : List~Fase~
        +Jogo(InterfaceJogo ui, List~Fase~ fases)
        +iniciar() void
        -criarPersonagem() Personagem
        -entregarItensIniciais(Personagem jogador) void
        -receberRecompensas(Personagem jogador, Fase fase) void
        -descansar(Personagem jogador) void
    }
    class Fase {
        <<record>>
        -inimigo : Oponente
        -recompensas : List~Item~
        +inimigo() Oponente
        +recompensas() List~Item~
    }
    class FabricaDeFases {
        -FabricaDeFases()
        +criarFases() List~Fase~$
    }

    %% ===== pacote rpg.combate =====
    class Combate {
        -ENERGIA_POR_TURNO : int$
        -jogador : Personagem
        -oponente : Oponente
        -ui : InterfaceJogo
        +Combate(Personagem jogador, Oponente oponente, InterfaceJogo ui)
        +executar() boolean
        -mostrarStatus() void
        -barra(int atual, int maximo) String
        -turnoDoJogador() void
        -menuHabilidades() boolean
        -menuItens() boolean
    }

    %% ===== pacote rpg.itens =====
    class Item {
        <<interface>>
        +getNome() String
        +getDescricao() String
        +usar(Personagem dono) String
    }
    class PocaoDeCura {
        -cura : int
        +PocaoDeCura(int cura)
        +getNome() String
        +getDescricao() String
        +usar(Personagem dono) String
    }
    class PocaoDeEnergia {
        -energia : int
        +PocaoDeEnergia(int energia)
        +getNome() String
        +getDescricao() String
        +usar(Personagem dono) String
    }
    class Equipamento {
        -nome : String
        -bonusAtaque : int
        -bonusDefesa : int
        +Equipamento(String nome, int bonusAtaque, int bonusDefesa)
        +getNome() String
        +getDescricao() String
        +usar(Personagem dono) String
    }
    class Inventario {
        -itens : List~Item~
        +adicionar(Item item) void
        +remover(int indice) Item
        +estaVazio() boolean
        +listar() List~Item~
    }

    %% ===== pacote rpg.ui =====
    class InterfaceJogo {
        <<interface>>
        +mostrar(String mensagem) void
        +lerTexto(String pergunta) String
        +lerOpcao(String pergunta, int min, int max) int
    }
    class ConsoleUI {
        -scanner : Scanner
        -saida : PrintStream
        +mostrar(String mensagem) void
        +lerTexto(String pergunta) String
        +lerOpcao(String pergunta, int min, int max) int
        -perguntar(String pergunta) String
    }

