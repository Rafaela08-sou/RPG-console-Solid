digraph RPG {
  rankdir=LR; splines=true; nodesep=0.4; ranksep=1.4; bgcolor="white";
  labelloc=t; fontsize=26; fontname="DejaVu Sans Bold"; label="Diagrama de Classes UML - RPG em Console\n ";
